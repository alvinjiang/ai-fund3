# .env.example — configuration SHAPE only. All values below are fake.
#
# Operator secrets live OUTSIDE the deploy tree at /etc/ai-fund/.env (chmod 0600),
# never in this repo (design/05 §6, AGENTS.md Absolute Rule 4). Copy this template
# there and fill in real values. Non-secret config (endpoints, schedules, budgets,
# model names/prices) lives in /etc/ai-fund/{houses,fund,pricing}.yaml, not here.
#
# The exact variable names are pinned by SPEC-CORE (Phase 1.2); this file documents
# the intended shape and is tightened as houses.yaml/settings are specced. Every
# value is a placeholder: replace_me / sk-test-... / dummy-token (AGENTS.md Rule 5).

# --- LLM provider API keys (analyst houses: GPT, Gemini, DeepSeek, GLM, Qwen) ---
# Claude (Anthropic) is reserved for the meta role (distillation/review), not an analyst.
OPENAI_API_KEY=sk-test-replace_me
GOOGLE_API_KEY=replace_me
DEEPSEEK_API_KEY=replace_me
ZAI_API_KEY=replace_me
DASHSCOPE_API_KEY=replace_me
ANTHROPIC_API_KEY=sk-ant-test-replace_me

# Optional provider endpoint overrides (non-secret; may also live in houses.yaml).
# Leave empty to use the provider default.
OPENAI_BASE_URL=
GOOGLE_BASE_URL=
DEEPSEEK_BASE_URL=
ZAI_BASE_URL=
DASHSCOPE_BASE_URL=
ANTHROPIC_BASE_URL=

# --- Postgres (single source of truth; PG-only queue, no Redis) ---
DATABASE_URL=postgresql://ai_fund:replace_me@localhost:5432/ai_fund

# --- Mattermost adapter (thin; bots = one per house + desk) ---
# Bot tokens keyed by house name; "desk" posts system/digest/gate/alert messages.
MATTERMOST_BOT_TOKENS={"gpt":"dummy-token","gemini":"dummy-token","deepseek":"dummy-token","glm":"dummy-token","qwen":"dummy-token","desk":"dummy-token"}
# Optional admin token for the adapter's `reconcile` command (setup reconciliation).
MATTERMOST_ADMIN_TOKEN=

# --- Market data service (ported v2 data_sources; one pinned price truth) ---
JQUANTS_API_KEY=replace_me
SEC_EDGAR_USER_AGENT=ai-fund research bot contact@example.com

# --- News fetchers (ported; tripwire scoring re-targeted in Phase 4) ---
NEWSDATA_API_KEY=replace_me
FINLIGHT_API_KEY=replace_me
FINNHUB_API_KEY=replace_me
NEWSAPI_KEY=replace_me
RSS_FEED_URLS=

# --- General search (api-substrate tool + sandbox search endpoint) ---
SEARCH_PROVIDER_ORDER=searxng,tavily
TAVILY_API_KEY=replace_me
BRAVE_SEARCH_API_KEY=replace_me
EXA_API_KEY=replace_me
# SearXNG is self-hosted (no key); configure its base URL in fund.yaml or here.
SEARXNG_BASE_URL=
SEARXNG_API_TOKEN=
